# Local customer signup/password login and separately provisioned admin login.
# Set to oidc to use organization SSO instead.
SUPPORTAI_AUTH_MODE=dev
SUPPORTAI_HOST=127.0.0.1
SUPPORTAI_COOKIE_SECURE=false

# OIDC / SSO configuration (required when SUPPORTAI_AUTH_MODE=oidc)
SUPPORTAI_OIDC_ISSUER=
SUPPORTAI_OIDC_CLIENT_ID=
SUPPORTAI_OIDC_CLIENT_SECRET=
SUPPORTAI_OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
SUPPORTAI_OIDC_ADMIN_EMAILS=
SUPPORTAI_OIDC_ADMIN_GROUPS=
SUPPORTAI_OIDC_GROUPS_CLAIM=groups

# Optional GenAI drafting; never paste real keys into source code.
SUPPORTAI_USE_GEMINI=false
GEMINI_API_KEY=
SUPPORTAI_GEMINI_MODEL=gemini-3.5-flash-lite
SUPPORTAI_KNOWLEDGE_MODE=vector

# Optional Zendesk agent API integration. Configure credentials only in .env.
SUPPORTAI_ZENDESK_SUBDOMAIN=
SUPPORTAI_ZENDESK_EMAIL=
SUPPORTAI_ZENDESK_API_TOKEN=
SUPPORTAI_ZENDESK_REQUESTER_ID=

# Optional shared PostgreSQL database (use for durable public deployments).
DATABASE_URL=
SUPPORTAI_REQUIRE_DATABASE=false
